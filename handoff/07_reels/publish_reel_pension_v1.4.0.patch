+CHRON_BOX = (190, 180, 700, 700)      # карта в сцене «хроника»: x0, y0, w, h
+CHRON_N = 10                          # сколько районов показываем
+CHRON_DIM = (34, 33, 30)              # остальные 108 районов гаснут
+_CHRON_CACHE: list | None = None
